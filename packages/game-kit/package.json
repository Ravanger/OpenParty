{
  "name": "@openparty/game-kit",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bots": {
      "types": "./dist/botsCli.d.ts",
      "default": "./dist/botsCli.js"
    },
    "./demo": {
      "types": "./dist/demoCli.d.ts",
      "default": "./dist/demoCli.js"
    },
    "./launch": {
      "types": "./dist/launch.d.ts",
      "default": "./dist/launch.js"
    },
    "./play": {
      "types": "./dist/play.d.ts",
      "default": "./dist/play.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@openparty/bots": "workspace:*",
    "@openparty/content": "workspace:*",
    "@openparty/core": "workspace:*",
    "@openparty/launcher": "workspace:*",
    "@openparty/server": "workspace:*",
    "@openparty/shared": "workspace:*",
    "@openparty/terminal": "workspace:*"
  },
  "devDependencies": {
    "@colyseus/schema": "^5.0.35",
    "@openparty/config": "workspace:*",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
