{
  "name": "@openparty/bluff",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "openparty": {
    "name": "Bluff",
    "description": "A bluffing party game for 3 to 8 players",
    "icon": "🎭"
  },
  "dependencies": {
    "@colyseus/schema": "^5.0.35",
    "@openparty/bots": "workspace:*",
    "@openparty/content": "workspace:*",
    "@openparty/core": "workspace:*",
    "@openparty/game-client": "workspace:*",
    "@openparty/game-kit": "workspace:*",
    "@openparty/game-ui": "workspace:*",
    "@openparty/shared": "workspace:*",
    "@openparty/terminal": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@openparty/config": "workspace:*",
    "@openparty/server": "workspace:*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^29.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --hot server.ts",
    "test": "vitest run",
    "test:all": "cd ../.. && bun x vitest run --project bluff --project bluff-game",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "build": "vite build",
    "demo": "bun run terminal/demo.ts"
  }
}
